# ------------------------------------------------------------------ general
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=text                    # text | json (structured, for log aggregation)
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --------------------------------------------------------------- rate limits
# Best-effort, single-process in-memory limiter (no Redis required). NOT
# shared across multiple workers/replicas — see docs/SYSTEM_DESIGN.md.
RATE_LIMIT_ENABLED=true
UPLOAD_RATE_LIMIT_PER_MINUTE=10
ANALYZE_RATE_LIMIT_PER_MINUTE=6
DEFAULT_RATE_LIMIT_PER_MINUTE=120

# ----------------------------------------------------------------- database
# Deliberately OUTSIDE storage_dir — storage_dir's subdirectories are served
# over HTTP; the database must never be reachable that way.
# DATA_DIR=/absolute/path/to/data
# DATABASE_URL=sqlite:////absolute/path/to/data/app.db

# ------------------------------------------------------------------- uploads
MAX_UPLOAD_MB=8192                 # 8 GB - supports 3h+ 1080p recordings
ALLOWED_EXTENSIONS=mp4,avi,mov,mkv

# -------------------------------------------------------------- motion / ROI
DEFAULT_MOTION_ALGORITHM=mog2      # mog2 | frame_diff | optical_flow | auto
FRAME_SAMPLE_STEP=2                # process every Nth frame
MIN_MOTION_AREA=800                # px^2 noise filter (fallback)
ROI_MIN_AREA_FRACTION=0.0008       # resolution-relative noise filter (preferred)
MOTION_THRESHOLD=0.012             # smoothed score to ENTER an active segment
MOTION_HYSTERESIS_RATIO=0.6        # score must drop below threshold*ratio to EXIT
MOTION_SMOOTHING_WINDOW=5          # trailing moving-average window (samples)
SEGMENT_MERGE_GAP_SEC=1.5
MIN_SEGMENT_DURATION_SEC=1.0
ROI_MERGE_IOU=0.2
ROI_MAX_RAW_CONTOURS=200           # perf guard against pathologically noisy frames

# -------------------------------------------------------------- yolo / model
YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE=0.35
YOLO_IOU=0.5
YOLO_DEVICE=auto                   # auto | cpu | cuda | cuda:0
ENABLE_OBJECT_DETECTION=true
YOLO_CACHE_SIZE=256                # perceptual-hash detection cache (0 disables)
# CUSTOM_YOLO_MODEL_PATH=/path/to/finetuned.pt
# CUSTOM_LABEL_MAP_PATH=/path/to/label_map.json

# ------------------------------------------------------------------- workers
TASK_BACKEND=thread                # thread | celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
FRAME_BUFFER_SIZE=64                # bounded read-ahead queue depth
