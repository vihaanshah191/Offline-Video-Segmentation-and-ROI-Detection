# ------------------------------------------------------------------ general
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----------------------------------------------------------------- database
# Defaults to a SQLite file under ./storage/app.db
# DATABASE_URL=sqlite:////absolute/path/to/storage/app.db

# ------------------------------------------------------------------- uploads
MAX_UPLOAD_MB=4096
ALLOWED_EXTENSIONS=mp4,avi,mov,mkv

# -------------------------------------------------------------- motion / ROI
DEFAULT_MOTION_ALGORITHM=mog2      # mog2 | frame_diff | optical_flow
FRAME_SAMPLE_STEP=2                # process every Nth frame
MIN_MOTION_AREA=800               # px^2 noise filter
MOTION_THRESHOLD=0.012            # fraction of frame in motion to be "active"
SEGMENT_MERGE_GAP_SEC=1.5
MIN_SEGMENT_DURATION_SEC=1.0
ROI_MERGE_IOU=0.2

# -------------------------------------------------------------- yolo / model
YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE=0.35
YOLO_IOU=0.5
YOLO_DEVICE=auto                  # auto | cpu | cuda | cuda:0
ENABLE_OBJECT_DETECTION=true

# ------------------------------------------------------------------- workers
TASK_BACKEND=thread               # thread | celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
