# API base URL. Leave unset in development to use Vite's proxy to the backend.
# In production point this at your backend, e.g. https://api.example.com/api
# VITE_API_URL=/api

# Origin used to resolve /storage/* artefact URLs (heatmaps, thumbnails).
# Defaults to the API origin. Set when the backend is on another host.
# VITE_STORAGE_ORIGIN=http://localhost:8000

# Backend target for the dev proxy (used by vite.config.ts).
VITE_PROXY_TARGET=http://localhost:8000
